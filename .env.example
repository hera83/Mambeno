# Kopiér til .env på serveren og udfyld: cp .env.example .env
# Variablerne overskriver appsettings.json ("__" svarer til ":" i config-nøglen).
# Udkommenterede værdier er standardværdierne fra appsettings.json.

# --- API-nøgler ---
# Master-nøglen giver adgang til /keys og /log. Brug en lang tilfældig værdi, fx: openssl rand -hex 32
ApiKeys__MasterKey=

# --- Mambeno (forbindelse til mambeno.dk) ---
#Mambeno__BaseUrl=https://mambeno.dk
#Mambeno__UserAgent=Mozilla/5.0 (compatible; MambenoRecipeSync/1.0)
#Mambeno__RequestTimeoutSeconds=60
#Mambeno__DelayBetweenRequestsMilliseconds=1500
#Mambeno__PageSize=100
#Mambeno__MaxRetries=3
#Mambeno__RetryBaseDelaySeconds=30

# --- Opskrifts-sync (natlig synkronisering fra Mambeno) ---
#RecipeSync__Enabled=true
#RecipeSync__DailyRunTime=03:30:00
#RecipeSync__TimeZone=Europe/Copenhagen
#RecipeSync__RetryDelayMinutes=60
#RecipeSync__MaxDeletionPercent=5
#RecipeSync__MaxDeletionsAlwaysAllowed=10
#RecipeSync__RefreshPerRun=100
#RecipeSync__MaxDataAgeDays=7
